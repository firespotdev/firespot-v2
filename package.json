{
  "name": "firespot-v2",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev:web": "pnpm --filter @firespot/web dev",
    "dev:admin": "pnpm --filter @firespot/admin dev",
    "dev:api": "pnpm --filter @firespot/api start:dev",
    "build:web": "pnpm --filter @firespot/web build",
    "build:admin": "pnpm --filter @firespot/admin build",
    "build:api": "pnpm --filter @firespot/api build",
    "build": "pnpm -r build"
  }
}
