# QR kit pricing, in NAIRA. Unset or 0 = free (current behaviour).
# Set a non-zero value to re-enable the Paystack paywall for that step.
QR_KIT_PRICE=0
QR_KIT_DELIVERY_FEE=0
QR_KIT_ACTIVATION_AMOUNT=1000
# Max kits a merchant can request in a single order.
QR_KIT_MAX_PER_ORDER=5

# Ledger amount recorded when a merchant referral reaches NGN 50,000.
# No payout is sent; 0 keeps qualification tracking active without a reward value.
MERCHANT_REFERRAL_REWARD_NAIRA=0
